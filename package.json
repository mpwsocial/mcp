{
  "name": "@moipayway/mcp",
  "version": "0.1.0",
  "description": "MoiPayWay MCP server for the API collection.",
  "type": "module",
  "bin": {
    "moipayway-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/catalog.json dist/catalog.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "keywords": ["moipayway", "mcp", "payments", "wallets"],
  "author": "MoiPayWay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpwsocial/mcp.git"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
